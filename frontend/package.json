{
  "name": "podex-frontend",
  "type": "module",
  "version": "0.41.13",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "generate:api": "openapi-typescript ./openapi.json -o ./src/lib/types.gen.ts",
    "check:api": "bun run generate:api && git diff --exit-code -- src/lib/types.gen.ts",
    "check": "astro check && bun run check:api",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^11.1.13",
    "@astrojs/react": "^7.0.0",
    "@sentry/browser": "^11.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.4.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "openapi-typescript": "7.13.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "fast-uri": "4.2.3",
    "source-map-js": "1.2.2",
    "glob": "14.0.4",
    "minimatch": "11.0.7"
  },
  "patchedDependencies": {
    "@redocly/openapi-core@1.34.21": "patches/@redocly%2Fopenapi-core@1.34.21.patch"
  }
}
